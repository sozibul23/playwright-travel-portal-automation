{
  "name": "flight-booking-automation",
  "version": "1.0.0",
  "description": "Playwright QA automation for the Innovate Solution B2B flight & hotel booking portal",
  "type": "module",
  "scripts": {
    "test": "playwright test --project=chrome",
    "test:full-matrix": "playwright test",
    "test:search": "playwright test tests/flights/02-search.spec.js --project=02-flight-search-form",
    "test:search:headed": "playwright test tests/flights/02-search.spec.js --project=02-flight-search-form --headed",
    "test:flight:booking": "playwright test tests/flights/06-booking.spec.js --project=chrome",
    "test:flight:booking:headed": "playwright test tests/flights/06-booking.spec.js --project=chrome --headed",
    "test:portal": "playwright test --project=01-auth-login --project=02-flight-search-form --project=03-flight-info --project=04-flight-filters --project=05-flight-pricing --project=06-flight-booking --project=07-flight-ticketing",
    "test:chrome": "playwright test --project=chrome",
    "test:chrome:headed": "playwright test --project=chrome --headed",
    "test:firefox": "playwright test --project=firefox",
    "test:firefox:headed": "playwright test --project=firefox --headed",
    "test:cross-browser": "playwright test --project=chrome --project=firefox",
    "test:supplier": "playwright test --grep @supplier",
    "test:atlas": "playwright test --project=supplier-atlas",
    "test:atlas:chrome": "playwright test --project=supplier-atlas-chrome",
    "test:atlas:firefox": "playwright test --project=supplier-atlas-firefox",
    "test:travelrobot": "playwright test --project=supplier-travelrobot",
    "test:travelrobot:chrome": "playwright test --project=supplier-travelrobot-chrome",
    "test:travelrobot:firefox": "playwright test --project=supplier-travelrobot-firefox",
    "test:yuehang": "playwright test --project=supplier-yuehang",
    "test:yuehang:chrome": "playwright test --project=supplier-yuehang-chrome",
    "test:yuehang:firefox": "playwright test --project=supplier-yuehang-firefox",
    "test:yuehang-atlas": "playwright test --project=supplier-yuehang-chrome --project=supplier-atlas-firefox",
    "test:yuehang-atlas:headed": "playwright test --project=supplier-yuehang-chrome --project=supplier-atlas-firefox --headed",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:functional": "playwright test --grep @functional",
    "test:headed": "playwright test --headed",
    "test:hotel": "playwright test --project=hotel",
    "test:hotel:headed": "playwright test --project=hotel --headed",
    "test:hotel:smoke": "playwright test --project=hotel-smoke",
    "test:hotel:smoke:headed": "playwright test --project=hotel-smoke --headed",
    "test:hotel:regression": "playwright test --project=hotel-regression",
    "test:hotel:regression:headed": "playwright test --project=hotel-regression --headed",
    "test:hotel:e2e": "playwright test --project=hotel-e2e",
    "test:hotel:e2e:headed": "playwright test --project=hotel-e2e --headed",
    "test:hotel:critical": "playwright test --project=hotel-critical",
    "test:hotel:critical:headed": "playwright test --project=hotel-critical --headed",
    "test:hotel:flaky": "playwright test --project=hotel-flaky",
    "test:hotel:flaky:headed": "playwright test --project=hotel-flaky --headed",
    "test:hotel:booking": "playwright test tests/hotels/regression/04-hotel-booking.spec.js --project=hotel-regression",
    "test:hotel:booking:headed": "playwright test tests/hotels/regression/04-hotel-booking.spec.js --project=hotel-regression --headed",
    "test:hotel:search": "playwright test tests/hotels/regression/01-hotel-search.spec.js --project=hotel-regression",
    "test:hotel:filters": "playwright test tests/hotels/regression/02-hotel-filters.spec.js --project=hotel-regression",
    "test:hotel:details": "playwright test tests/hotels/regression/03-hotel-details.spec.js --project=hotel-regression",
    "test:hotel:confirmation": "playwright test tests/hotels/regression/05-hotel-confirmation.spec.js --project=hotel-regression",
    "test:hotel:history": "playwright test tests/hotels/regression/06-hotel-history.spec.js --project=hotel-regression",
    "test:hotel:cancellation": "playwright test tests/hotels/regression/07-hotel-cancellation.spec.js --project=hotel-regression",
    "test:coupon": "playwright test tests/flights/08-flight-coupon.spec.js --project=chrome && playwright test tests/b2c/flights/01-flight-coupon.spec.js --project=b2c",
    "test:coupon:headed": "playwright test tests/flights/08-flight-coupon.spec.js --project=chrome --headed && playwright test tests/b2c/flights/01-flight-coupon.spec.js --project=b2c --headed",
    "test:coupon:b2b": "playwright test tests/flights/08-flight-coupon.spec.js --project=chrome",
    "test:coupon:b2b:headed": "playwright test tests/flights/08-flight-coupon.spec.js --project=chrome --headed",
    "test:coupon:b2c": "playwright test tests/b2c/flights/01-flight-coupon.spec.js --project=b2c",
    "test:coupon:b2c:headed": "playwright test tests/b2c/flights/01-flight-coupon.spec.js --project=b2c --headed",
    "test:coupon:limit:cycle": "playwright test tests/flights/09-limit-exhaustion.spec.js --project=chrome",
    "test:coupon:limit:cycle:headed": "playwright test tests/flights/09-limit-exhaustion.spec.js --project=chrome --headed",
    "test:coupon:booking:e2e": "playwright test tests/flights/10-coupon-booking-e2e.spec.js --project=chrome",
    "test:coupon:booking:e2e:headed": "playwright test tests/flights/10-coupon-booking-e2e.spec.js --project=chrome --headed",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:single-file": "allure generate allure-results --single-file --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report:html:show": "playwright show-report reports/html-report",
    "allure:clean": "node -e \"const fs = require('fs'); fs.rmSync('allure-results', { recursive: true, force: true }); fs.rmSync('allure-report', { recursive: true, force: true });\"",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:serve": "allure serve allure-results"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "allure-commandline": "^2.27.0",
    "allure-playwright": "^2.13.0",
    "dotenv": "^16.3.1"
  }
}